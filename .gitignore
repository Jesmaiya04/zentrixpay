# Logs
*.log

# Editor / OS
.DS_Store
.vercel
.idea/

# pnpm local store (cached tarballs — not source, regenerated on install)
.pnpm-store/

# Test snapshots (generated by vitest; committed only when intentionally updated)
**/__snapshots__/

# Compiled outputs that are generated from source and should not be committed
packages/registry-client/vitest.config.js
packages/registry-client/vitest.config.js.map
packages/registry-client/vitest.config.d.ts
packages/registry-client/vitest.config.d.ts.map

